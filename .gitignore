# Segredos — NUNCA commitar chaves de API
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Sistema
.DS_Store

# Segredos e backups (nunca commitar)
.streamlit/secrets.toml
.streamlit/secrets.toml.*
!.streamlit/secrets.toml.example
*.bak

# Mapas administrativos de identidade — contêm e-mails/UIDs reais
vinculos*.json
vinculo-*.json
contas-auth*.json

# cache do pytest — nunca deve ir para o repositório: guarda os IDs
# dos testes, e os parametrizados carregam no nome os literais de
# credencial falsa que a suíte monta em runtime
.pytest_cache/

# Cartographer — mapa semântico do código para o agente de desenvolvimento
#
# O ÍNDICE não é versionado: é derivado do código, pesa megabytes, muda a
# cada commit e recriá-lo custa segundos (`cartographer index .`). Um .db
# binário no repositório daria conflito de merge em toda branch.
#
# A CONFIGURAÇÃO é versionada, e de propósito — é ela que mantém o índice
# local ao projeto em vez de cair no banco global de ~/.cartographer/,
# que misturaria este repositório com qualquer outro da máquina.
.cartographer/*
!.cartographer/config.json

{
  "mcpServers": {
    "cartographer": {
      "command": "cartographer-mcp",
      "args": []
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp?client=claude-code-plugin",
      "headers": {
        "Authorization": "${CONTEXT7_API_KEY:-}"
      }
    },
    "headroom": {
      "type": "stdio",
      "command": "headroom",
      "args": ["mcp", "serve"],
      "env": {
        "HEADROOM_BEACON": "off",
        "DO_NOT_TRACK": "1"
      }
    }
  }
}

# ###########################################################
#  MODELO do arquivo de segredos do servidor
#
#  ESTE ARQUIVO NÃO CONTÉM SEGREDO NENHUM, e não pode passar a
#  conter. Ele é versionado; o arquivo de verdade não é.
#
#  No VPS:
#      sudo mkdir -p /etc/govdocs
#      sudo nano /etc/govdocs/env      # cole os valores AQUI
#      sudo chmod 600 /etc/govdocs/env
#      sudo chown root:root /etc/govdocs/env
#
#  Os valores você copia do painel do Supabase e do painel
#  administrativo do próprio sistema. Eu não os leio, não os
#  peço e não os escrevo em lugar nenhum — é a regra desta
#  empreitada desde a primeira sessão, e ela não muda porque a
#  hospedagem mudou.
#
#  `chmod 600` importa: o `env_file` do compose é lido pelo
#  daemon do Docker, que roda como root. Não há razão para o
#  arquivo ser legível por mais ninguém.
# ###########################################################

# --- Supabase: banco, autenticação e RLS continuam lá ---------
# A migração é só da hospedagem do aplicativo. Estes dois são o
# mínimo para o app subir.
SUPABASE_URL=
SUPABASE_KEY=

# Credencial de servidor. O nome mudou entre versões do Supabase;
# o código aceita os três e prefere nesta ordem. Preencha o que o
# seu painel mostrar — e só um deles.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_KEY=

# --- Qual instalação é esta ------------------------------------
# AUSENTE = produção, e o default é esse de propósito: instalação que
# esquece de se declarar deve ser tratada como a mais séria, não como a
# menos. O VPS deixa em branco; o Streamlit Cloud declara
# `homologacao` nos Secrets dele, e aí o app desenha a tarja.
# GOVDOCS_AMBIENTE=

# --- Portões de falha fechada ---------------------------------
# PRODUÇÃO DEVE MANTER OS DOIS LIGADOS.
#
# `EXIGIR_CREDENCIAL_SERVIDOR` faz o app recusar subir sem a
# credencial em vez de degradar para um modo que lê menos.
# `EXIGIR_SUPABASE_AUTH` impede o modo aberto de ser usado sem
# querer — é ele que garante que todo acesso passa por login.
GOVDOCS_EXIGIR_CREDENCIAL_SERVIDOR=1
GOVDOCS_EXIGIR_SUPABASE_AUTH=1

# `GOVDOCS_MODO_ABERTO` NÃO aparece aqui preenchido de propósito:
# ele é o modo sem login, para desenvolvimento. Ligar isso num
# servidor com domínio público abriria o sistema inteiro.

# --- Política de roteamento de modelo --------------------------
# Era isto que você tinha ligado no Streamlit Cloud, e é a linha
# que NÃO pode se perder na mudança de hospedagem: com ela
# desligada, um edital volta a poder cair para um motor não
# homologado quando a OpenAI falhar.
OMNIROUTE_ROUTING_ENABLED=true

# O gateway em si continua desligado: não há gateway rodando, e
# deixar a chave armada faria efeito no dia em que alguém subisse
# um. Ver docs/OMNIROUTE_INTEGRATION.md.
# OMNIROUTE_ENABLED=
# OMNIROUTE_BASE_URL=

# --- Chaves de IA ----------------------------------------------
# OPCIONAIS AQUI. O sistema lê chave de IA na ordem
#   painel do administrador (banco) > sessão > secrets > ambiente
# e hoje elas vivem no `config_app`, no Supabase — que continua
# sendo a fonte depois da migração. Preencha abaixo apenas se
# quiser que o servidor tenha uma chave própria, independente do
# banco.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Exemplo SEM valores reais. Não comitar arquivo preenchido nem expor via NEXT_PUBLIC_*.
APP_ENV=development
# Next.js (somente dados publicáveis, nunca SUPABASE_SECRET_KEY):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-STAGING.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLOCAR_CHAVE_PUBLICAVEL_STAGING
# API/worker (apenas backend e secret store protegido):
SUPABASE_URL=https://SEU-STAGING.supabase.co
SUPABASE_SECRET_KEY=CONFIGURAR_FORA_DO_GIT
REDIS_URL=redis://redis:6379/0
GOVDOCS_EXIGIR_CREDENCIAL_SERVIDOR=1
GOVDOCS_MODO_ABERTO=0
PRICE_RESEARCH_ENABLED=0
DOCUMENTS_NEXT_UI_ENABLED=0
# Produção e staging devem ter projetos Supabase separados.

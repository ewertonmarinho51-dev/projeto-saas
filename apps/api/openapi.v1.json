  "info": {
    "title": "Gov Conect API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sessão ausente ou inválida"
          },
          "503": {
            "description": "Autenticação indisponível"
          }
        },
        "summary": "Me",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/processos": {
      "get": {
        "operationId": "listar_api_v1_processos_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaDeProcessos"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar",
        "tags": [
          "v1",
          "processos"
        ]
      },
      "post": {
        "operationId": "criar_api_v1_processos_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoProcesso"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processo"
                }
              }
            },
            "description": "Repetição da mesma Idempotency-Key"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processo"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Idempotency-Key já usada com outro conteúdo"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Criar",
        "tags": [
          "v1",
          "processos"
        ]
      }
    },
    "/api/v1/processos/{processo_id}": {
      "get": {
        "operationId": "consultar_api_v1_processos__processo_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "processo_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Processo Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processo"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Inexistente ou fora do seu acesso"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consultar",
        "tags": [
          "v1",
          "processos"
        ]
      },
      "patch": {
        "operationId": "editar_api_v1_processos__processo_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "processo_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Processo Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EdicaoDeProcesso"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processo"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Inexistente ou fora do seu acesso"
          },
          "409": {
            "description": "Versão desatualizada"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "428": {
            "description": "If-Match ausente"
          }
        },
        "summary": "Editar",
        "tags": [
          "v1",
          "processos"
        ]
      }
    },

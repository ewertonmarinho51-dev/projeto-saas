          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pronto"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Pronto",
        "tags": [
          "saude"
        ]
      }
    }
